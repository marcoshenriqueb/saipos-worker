NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saipos

# Worker mode: idle | ingest | normalize
WORKER_MODE=ingest

# Main loop interval (ms)
POLL_INTERVAL_MS=60000

# Saipos Data API
SAIPOS_DATA_API_URL=https://data.saipos.io
SAIPOS_DATA_TOKEN=replace_with_jwt_token

# Ingest window (days back from now - 26h)
INGEST_DAYS_BACK=2

# Normalizer batch size per cycle
NORMALIZER_BATCH_SIZE=100


# Financial worker mode: idle | ingest
FINANCIAL_WORKER_MODE=idle

# Financial ingest window (max 15 days per request on Saipos)
FINANCIAL_INGEST_DAYS_BACK=7
FINANCIAL_INGEST_DATE_COLUMN_FILTER=updated_at
FINANCIAL_INGEST_LOOKBACK_HOURS=26

# Financial normalizer batch size per cycle
FINANCIAL_NORMALIZER_BATCH_SIZE=100
