NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saipos

# Worker mode: idle | ingest | normalize
WORKER_MODE=ingest

# Main loop interval (ms)
POLL_INTERVAL_MS=60000

# Saipos Data API
SAIPOS_DATA_API_URL=https://data.saipos.io
SAIPOS_DATA_TOKEN=replace_with_jwt_token

# Ingest window (days back from now - 26h)
INGEST_DAYS_BACK=2

# Normalizer batch size per cycle
NORMALIZER_BATCH_SIZE=100


# Financial worker mode: idle | ingest
FINANCIAL_WORKER_MODE=idle

# Financial ingest — worker faz 2 passes/ciclo (max 15 dias por request na Saipos)
# Pass updated_at: edições e lançamentos recém-criados
FINANCIAL_INGEST_DAYS_BACK=7
FINANCIAL_INGEST_LOOKBACK_HOURS=26
# Pass date: janela operacional (vencimentos). dateDaysBack + dateDaysForward <= 15
FINANCIAL_INGEST_DATE_DAYS_BACK=8
FINANCIAL_INGEST_DATE_DAYS_FORWARD=6

# Financial normalizer batch size per cycle
FINANCIAL_NORMALIZER_BATCH_SIZE=100

# Financial deletion sweep (daily full read of the Saipos API by `date`)
# off | dry_run | apply  — dry_run only records counts in financial_sweeps
FINANCIAL_SWEEP_MODE=dry_run
FINANCIAL_SWEEP_AT=04:30
FINANCIAL_SWEEP_TZ=America/Sao_Paulo
FINANCIAL_SWEEP_RANGE_START=2025-09-01
FINANCIAL_SWEEP_FORWARD_DAYS=31
FINANCIAL_SWEEP_SLEEP_MS=400
FINANCIAL_SWEEP_BREAKER_MIN=50
FINANCIAL_SWEEP_BREAKER_PCT=5
FINANCIAL_SWEEP_MIN_STRIKE_GAP_HOURS=20
